# Cache policy for hosts that honor `_headers` (Cloudflare Pages, Netlify).
# GitHub Pages ignores this file and always sends max-age=600.
# With Cloudflare proxying GitHub Pages, apply the matching Cache Rules
# in docs/batch-c-cloudflare-cache.md instead.

# HTML: short cache so publishes show up quickly
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Fingerprinted / versioned static assets (?v= on URLs)
/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=31536000, immutable
